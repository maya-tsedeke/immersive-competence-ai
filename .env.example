# --- Vercel / default Next.js build ---
# Leave unset: full-featured build (no static export, image optimization on, PWA in production).

# --- GitHub Pages (static export) ---
# Build with: NEXT_STATIC_EXPORT=1 npm run build
# NEXT_STATIC_EXPORT=1

# Subpath when hosted at https://USER.github.io/REPOSITORY_NAME/
# (leading slash, no trailing slash). Also baked into client for manifest / assets.
# NEXT_PUBLIC_BASE_PATH=/REPOSITORY_NAME
